<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ introCopy or subtitle or site.tagline }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/styles.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand-logo">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">{{ site.name }}</span>
      </a>

      <nav class="main-nav" aria-label="Primary Navigation">
        {% for item in site.nav %}
          <a href="{{ item.url }}" class="nav-link {% if page.url == item.url %}active{% endif %}">{{ item.label }}</a>
        {% endfor %}
      </nav>

      <div class="header-cta">
        <a href="/bingo/" class="btn btn-primary btn-sm">Play Bingo</a>
      </div>
    </div>
  </header>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col brand-col">
          <div class="brand-logo footer-brand">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">{{ site.name }}</span>
          </div>
          <p class="footer-desc">
            Partnering with Fortune 500 enterprises to align generative machine learning with holistic data lake infrastructure and deliver sustainable, bottom-line ROI.
          </p>
          <p class="footer-locations">{{ site.headquarters }}</p>
        </div>

        <div class="footer-col">
          <h4>Capabilities</h4>
          <ul>
            <li><a href="/#pillars">Holistic Data Lake Infrastructure</a></li>
            <li><a href="/#pillars">Generative AI Strategy</a></li>
            <li><a href="/#pillars">Omnichannel Enablement</a></li>
            <li><a href="/#insights">Research &amp; Benchmarks</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Thought Leadership</h4>
          <ul>
            {% for post in collections.thoughtLeadership %}
              <li><a href="{{ post.url }}">{{ post.data.title | truncate(46) }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="footer-col">
          <h4>Company</h4>
          <ul>
            <li><a href="/testimonials/">Industry Testimonials</a></li>
            <li><a href="/team/">Executive Leadership</a></li>
            <li><a href="/case-studies/">Client Case Studies</a></li>
            <li><a href="/thought-leadership/">Publications</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© 2026 {{ site.legalName }} All rights reserved.</p>
      </div>
    </div>
  </footer>
</body>
</html>
